# Copie para .env e preencha com valores reais. Nunca faça commit do .env.
# Em staging e produção, estes valores vêm de GitHub Secrets / variáveis do provedor de hospedagem.

# Ambiente: development | staging | production
APP_ENV=development
# Em staging e produção, deve ser true (redireciona HTTP para HTTPS e ativa HSTS)
FORCE_HTTPS=false
SECRET_KEY=troque-por-uma-chave-aleatoria
ALLOWED_ORIGINS=http://localhost:3000

# Banco de dados (Supabase / PostgreSQL)
DATABASE_URL=postgresql://vero:vero@localhost:5432/vero
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chave usada para criptografar dados sensíveis em repouso (telefone, valores)
DATA_ENCRYPTION_KEY=

# Evolution API
EVOLUTION_URL=http://localhost:8080
AUTHENTICATION_API_KEY=
INSTANCE_NAME=vero-whatsapp

# PostgreSQL Evolution API
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI="postgresql://postgres:postgres@postgres-evolution:5432/evolution?schema=public"
DATABASE_CONNECTION_CLIENT_NAME=

DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# Valkey Evolution API
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://valkey-evolution:6379/1
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_TTL=604800
CACHE_REDIS_SAVE_INSTANCES=true

# Assistente de IA (texto, áudio e imagem)
AI_API_KEY=

# Frontend (apenas valores públicos podem usar o prefixo NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8000
